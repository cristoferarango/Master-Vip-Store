# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# base de datos local SQLite (datos reales/credenciales cifradas — no va al repo)
/prisma/dev.db
/prisma/dev.db-journal

# imágenes subidas por usuarios en desarrollo local
/public/uploads/*
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/scheduled_tasks.lock

# skills personales de seguridad/investigación (no van al repo público)
.claude/skills/0day-scanner/
.claude/skills/cti-search-skill/
.claude/skills/notebooklm/
.claude/skills/opengrep-rule-generator/
.claude/skills/opengrep-rule-generator-research/
.claude/skills/secure-prd-skill/
.claude/skills/security-assessment/
.claude/skills/security-reviewer/
.claude/skills/threat-modeling/
