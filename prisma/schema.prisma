generator client {
  provider = "prisma-client-js"
}

// SQLite local (archivo dentro del proyecto, ver .env DATABASE_URL) — para
// pruebas sin depender de un servidor/hosting de base de datos. Migrar a
// PostgreSQL más adelante solo implica cambiar "provider" aquí, el adapter
// en lib/db/prisma.ts, y volver a agregar los @db.Decimal/@db.Text si se
// quiere aprovechar esos tipos nativos de Postgres.
datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENTE
  PROVEEDOR
  ADMIN
}

enum ProviderStatus {
  PENDIENTE
  ACTIVO
  SUSPENDIDO
}

enum StockStatus {
  DISPONIBLE
  VENDIDA
}

enum PurchaseStatus {
  ACTIVA
  VENCIDA
  REEMBOLSADA
}

enum DepositStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum WalletTxType {
  RECARGA
  COMPRA
  AJUSTE
}

enum NotificationType {
  DEPOSITO_APROBADO
  DEPOSITO_RECHAZADO
  CUENTA_POR_VENCER
  CUENTA_VENCIDA
  BIENVENIDA
  PROVEEDOR_ACTIVADO
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SISTEMA
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  whatsapp     String
  role         Role     @default(CLIENTE) // informativo (con qué rol se registró primero) — el acceso real se decide por capacidad: isAdmin, providerProfile != null, o simplemente estar logueado para Streaming.
  isAdmin      Boolean  @default(false)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet          Wallet?
  providerProfile Provider?
  purchases       Purchase[]
  depositRequests DepositRequest[]
  reviews         Review[]
  notifications   Notification[]

  @@index([role])
}

model Provider {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  bio          String?
  avatarUrl    String?
  status       ProviderStatus @default(PENDIENTE)
  ratingAvg    Decimal        @default(0)
  ratingCount  Int            @default(0)
  activatedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  products  Product[]
  purchases Purchase[]
  reviews   Review[]

  @@index([status])
}

model Category {
  id      String @id @default(cuid())
  name    String @unique
  slug    String @unique
  iconUrl String?
  order   Int    @default(0)

  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  providerId   String
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  name         String
  slug         String   @unique
  imageUrl     String
  description  String
  conditions   String
  price        Decimal
  durationDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockItems AccountStock[]
  purchases  Purchase[]
  reviews    Review[]

  @@index([categoryId])
  @@index([providerId])
}

// Cada fila = una credencial individual disponible para vender bajo un Product
model AccountStock {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  usernameEncrypted  String
  passwordEncrypted  String
  extraInfoEncrypted String?
  status             StockStatus  @default(DISPONIBLE)
  purchase           Purchase?
  createdAt          DateTime     @default(now())

  @@index([productId, status])
}

model Purchase {
  id              String   @id @default(cuid())
  clienteId       String
  cliente         User     @relation(fields: [clienteId], references: [id])
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  accountStockId  String   @unique
  accountStock    AccountStock @relation(fields: [accountStockId], references: [id])

  pricePaid       Decimal
  purchaseDate    DateTime       @default(now())
  expirationDate  DateTime
  status          PurchaseStatus @default(ACTIVA)

  // Snapshot cifrado propio, inmutable aunque el proveedor edite el AccountStock original
  credentialUsernameEncrypted String
  credentialPasswordEncrypted String

  review    Review?
  createdAt DateTime @default(now())

  @@index([clienteId])
  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Wallet / pagos
// ---------------------------------------------------------------------------

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0)
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        WalletTxType
  amount      Decimal      // positivo = ingreso, negativo = egreso
  referenceId String?
  createdAt   DateTime     @default(now())

  @@index([walletId])
}

model DepositRequest {
  id                String        @id @default(cuid())
  clienteId         String
  cliente           User          @relation(fields: [clienteId], references: [id])
  amount            Decimal
  operationCode     String?
  screenshotUrl     String?
  status            DepositStatus @default(PENDIENTE)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime      @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// Social / notificaciones
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  clienteId  String
  cliente    User     @relation(fields: [clienteId], references: [id])
  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([providerId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(WHATSAPP)
  title     String
  message   String
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
}
